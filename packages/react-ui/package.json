{
  "name": "@snacky/ui",
  "version": "0.1.7",
  "description": "Snacky App design system - React component library. Generated from the source-of-truth design system at ../../index.html (tokens.json / components.json), pixel-accurate to Figma.",
  "license": "MIT",
  "author": "rezatresnas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rezatresnas/snacky-design-system.git",
    "directory": "packages/react-ui"
  },
  "homepage": "https://github.com/rezatresnas/snacky-design-system/tree/main/packages/react-ui#readme",
  "bugs": {
    "url": "https://github.com/rezatresnas/snacky-design-system/issues"
  },
  "keywords": [
    "design-system",
    "react",
    "component-library",
    "ui",
    "figma"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  }
}
